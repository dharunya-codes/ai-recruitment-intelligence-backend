# ==============================================================================
# LM-Inspect AI - Backend Environment Configuration
# ==============================================================================

# Base URL for the future AI / Computer Vision / Rule Engine Backend
# Examples:
#   Local FastAPI / Flask server: http://localhost:8000/api/v1
#   Staging server: https://staging-api.legalmetrology.gov.in/api/v1
#   Production server: https://api.legalmetrology.gov.in/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Master Toggle:
# Set to 'false' to route all API calls to the real backend.
# Set to 'true' to use the realistic offline mock service for testing/demos.
VITE_USE_MOCK=true
